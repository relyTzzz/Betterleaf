node_modules/
dist/
out/
release/
# NB: no blanket `build/` rule. Nothing here builds into a directory by that
# name (protocol -> dist/, app -> out/ and release/), and packages/app/build is
# electron-builder's buildResources input — it holds the app icon and must be
# committed or a fresh clone can't package the app.
*.tsbuildinfo
.vite/
coverage/

# Local device tokens / scratch state — never commit
.betterleaf/
*.local.json

.DS_Store
Thumbs.db
.env
.env.local

# Effect exports land wherever you run the CLI; not repo content.
*-effects.json

# Rendered by `pnpm screenshots` for the site and README; regenerate, do not commit.
screenshots/
